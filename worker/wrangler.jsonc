{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verselight-reports",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "observability": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "verselight-daily-2026",
    "ALLOWED_ORIGIN": "https://chartmann1590.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "verselight-moderation",
      "database_id": "8001a9e1-58a7-464b-b46f-d079c9127f9e",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
