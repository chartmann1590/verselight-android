rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(name) { return name is string && name.size() >= 1 && name.size() <= 40; }

    match /users/{uid} {
      allow create, read, update, delete: if owner(uid);
      match /{privateCollection}/{document=**} {
        allow read, write: if owner(uid);
      }
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'avatarUrl'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.displayName)
        && (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string);
      allow delete: if owner(uid);
    }

    match /dailyVerses/{dayKey} {
      allow read: if true;
      allow write: if false;

      match /comments/{commentId} {
        allow read: if resource.data.moderationStatus in ['visible', 'restored'];
        // Comment creation and moderation are server-authoritative. The app first
        // performs on-device AI moderation, then the reporting Worker applies a
        // second safety gate and writes through its least-privileged service account.
        allow create, update: if false;
        allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }
    }
  }
}
